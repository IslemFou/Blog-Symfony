{% extends 'base.html.twig' %}

{% block title %}Articles index{% endblock %}

{% block main %}
    <h2>Mes articles</h2>

<div class="text-center">
    
        <a href="{{ path('app_articles_new') }}" class="btn btn-primary">Ajout d'article</a>
</div>

<div class="row">
    {# {{ dump(article) }} #}
    {% for article in articles %}
    
        <div class="col-sm-4 m-auto">
            <div class="card mb-3">
                <img src="{{asset("images/articles/" ~ article.image )}}" class="card-img-top h-auto" alt="" >
                <div class="card-body">
                    <h5 class="card-title">{{article.title}}</h5>
                    <p class="card-text">{{article.content}}</p>
                    <h6 class="card-text"> Article créé le : <small class="text-body-secondary">{{article.createdAt | date("d-m-Y")}}</small></h6>
                    <a href="{{path('app_articles_show', {id : article.id})}}" class="btn btn-success">Voir l'article</a>
                    <a href="{{path('app_articles_edit', {id : article.id})}}" class="btn btn-warning">Modifier l'article</a>
                    {# <a href="" class="btn btn-danger">Supprimer l'article</a> #}
                    <form method="post" action="{{ path('app_articles_delete', {'id': article.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
                    <button class="btn btn-danger mt-3">Delete</button>
                    </form>

                </div>
            </div>
        </div>  
        
    {% endfor %}
  
</div>


{% endblock %}
