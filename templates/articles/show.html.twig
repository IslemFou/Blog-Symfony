{% extends 'base.html.twig' %}

{% block title %}Articles{% endblock %}

{% block main %}
    <h2>Article n° {{article.id}} </h2>

    
    <a href="{{ path('app_articles_edit', {'id': article.id}) }}" class="btn btn-warning">Modifier l'article</a>

    {{ include('articles/_delete_form.html.twig') }}

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ article.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ article.title }}</td>
            </tr>
            <tr>
                <th>Content</th>
                <td>{{ article.content }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td> <img src="{{asset("images/articles/" ~ article.image )}}"  alt="Image de l'article" ></td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ article.createdAt ? article.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ article.updatedAt ? article.updatedAt|date('Y-m-d H:i:s') : 'Pas modifié' }}</td>
            </tr>
        </tbody>
    </table>


{% endblock %}
